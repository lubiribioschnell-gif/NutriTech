<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NutriTech - Cadastro de Usuário</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/auth.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
</head>

<body>
    <%- include("../partials/mensagem") %>
        <div class="container">

            <div class="left">

                <aside class="auth-lateral">
                    <div class="auth-logo">
                        <img src="/img/logo.png" alt="Logo NutriTech">
                        <h1>NutriTech</h1>
                        <p>Alimentação saudável e acompanhamento nutricional.</p>
                    </div>
                </aside>

            </div>

            <div class="right">

                <div class="card cadastroCard">

                    <h2>Criar conta de usuário</h2>

                    <p class="subtituloAuth">
                        Preencha seus dados para começar a usar o NutriTech.
                    </p>

                    <form action="/cadastroUsuario" method="POST" enctype="multipart/form-data">

                        <div class="duasColunas">

                            <div class="inputBox">
                                <label>Nome Completo</label>
                                <input type="text" name="nome" placeholder="Digite seu nome" minlength="3"
                                    maxlength="100" autocomplete="name" required>
                            </div>

                            <div class="inputBox">
                                <label>Email</label>
                                <input type="email" name="email" placeholder="Digite seu e-mail" maxlength="150"
                                    autocomplete="email" required>
                            </div>

                        </div>

                        <div class="duasColunas">

                            <div class="inputBox">
                                <label>Senha</label>
                                <input type="password" id="senha" name="senha" placeholder="Digite sua senha"
                                    minlength="6" maxlength="72" autocomplete="new-password" required>
                            </div>

                            <div class="inputBox">
                                <label>Confirmar Senha</label>
                                <input type="password" id="confirmarSenha" name="confirmarSenha"
                                    placeholder="Confirme sua senha" minlength="6" maxlength="72"
                                    autocomplete="new-password" required>
                            </div>

                        </div>

                        <div class="mostrar">

                            <input type="checkbox" onclick="mostrarSenha()">

                            Mostrar senhas

                        </div>

                        <div class="duasColunas">

                            <div class="inputBox">
                                <label>Data de Nascimento</label>
                                <input type="date" id="data_nascimento" name="data_nascimento" required>
                            </div>

                            <div class="inputBox">

                                <label>Sexo</label>

                                <select name="sexo" required>

                                    <option value="">Selecione</option>
                                    <option value="Masculino">Masculino</option>
                                    <option value="Feminino">Feminino</option>
                                    <option value="Outro">Prefiro não informar</option>

                                </select>

                            </div>

                        </div>

                        <div class="duasColunas">

                            <div class="inputBox">
                                <label>Peso (kg)</label>
                                <input type="number" step="0.1" min="20" max="400" name="peso" placeholder="Ex: 70"
                                    required>
                            </div>

                            <div class="inputBox">
                                <label>Altura (m)</label>
                                <input type="number" step="0.01" min="0.80" max="2.50" name="altura"
                                    placeholder="Ex: 1.75" required>
                            </div>

                        </div>

                        <div class="inputBox">

                            <label>Foto de Perfil</label>
                        </div>

                        <input type="file" name="foto" accept="image/jpeg,image/png,image/webp">

                        <button type="submit" class="btn">

                            Cadastrar

                        </button>

                    </form>

                    <div class="cadastro">

                        Já possui uma conta?

                        <a href="/login">Entrar</a>

                    </div>

                </div>

            </div>

        </div>

        <script>

            function mostrarSenha() {

                const senha = document.getElementById("senha");
                const confirmar = document.getElementById("confirmarSenha");

                if (senha.type === "password") {

                    senha.type = "text";
                    confirmar.type = "text";

                } else {

                    senha.type = "password";
                    confirmar.type = "password";

                }

            }
            const campoData =
                document.getElementById("data_nascimento");

            const hoje = new Date();
            const ano = hoje.getFullYear();
            const mes = String(
                hoje.getMonth() + 1
            ).padStart(2, "0");

            const dia = String(
                hoje.getDate()
            ).padStart(2, "0");

            campoData.max = `${ano}-${mes}-${dia}`;
        </script>

</body>

</html>