<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        NutriTech - Cadastro de Nutricionista
    </title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
</head>

<body class="paginaCadastroNutricionista">

    <%- include("../partials/mensagem") %>

        <div class="container">

            <section class="left">

                <aside class="auth-lateral">
                    <div class="auth-logo">
                        <img src="/img/logo.png" alt="Logo NutriTech">
                        <h1>NutriTech</h1>
                        <p>Alimentação saudável e acompanhamento nutricional.</p>
                    </div>
                </aside>

            </section>

            <section class="right">

                <div class="card cadastroCard">

                    <div class="cabecalhoAuth">

                        <span class="etiquetaAuth">
                            Área profissional
                        </span>

                        <h2>Cadastro de nutricionista</h2>

                        <p class="subtituloAuth">
                            Preencha seus dados pessoais e profissionais
                            para solicitar acesso à plataforma.
                        </p>

                    </div>

                    <form action="/cadastroNutricionista" method="POST" enctype="multipart/form-data">

                        <div class="grupoFormulario">

                            <div class="tituloGrupo">
                                <span>1</span>

                                <div>
                                    <h3>Dados pessoais</h3>
                                    <p>Informações básicas da sua conta.</p>
                                </div>
                            </div>

                            <div class="duasColunas">

                                <div class="inputBox">
                                    <label for="nome">
                                        Nome completo
                                    </label>

                                    <input type="text" id="nome" name="nome" placeholder="Digite seu nome completo"
                                        minlength="3" maxlength="100" autocomplete="name" required>
                                </div>

                                <div class="inputBox">
                                    <label for="email">
                                        E-mail
                                    </label>

                                    <input type="email" id="email" name="email" placeholder="seuemail@exemplo.com"
                                        maxlength="150" autocomplete="email" required>
                                </div>

                            </div>

                            <div class="duasColunas">

                                <div class="inputBox">
                                    <label for="data_nascimento">
                                        Data de nascimento
                                    </label>

                                    <input type="date" id="data_nascimento" name="data_nascimento" required>
                                </div>

                                <div class="inputBox">
                                    <label for="sexo">
                                        Sexo
                                    </label>

                                    <select id="sexo" name="sexo" required>
                                        <option value="">
                                            Selecione
                                        </option>

                                        <option value="Masculino">
                                            Masculino
                                        </option>

                                        <option value="Feminino">
                                            Feminino
                                        </option>

                                        <option value="Outro">
                                            Outro
                                        </option>
                                    </select>
                                </div>

                            </div>

                        </div>

                        <div class="grupoFormulario">

                            <div class="tituloGrupo">
                                <span>2</span>

                                <div>
                                    <h3>Dados profissionais</h3>
                                    <p>Informações sobre sua atuação.</p>
                                </div>
                            </div>

                            <div class="duasColunas">

                                <div class="inputBox">
                                    <label for="crn">
                                        CRN
                                    </label>

                                    <input type="text" id="crn" name="crn" placeholder="Ex.: CRN-2 12345" minlength="4"
                                        maxlength="30" required>
                                </div>

                                <div class="inputBox">
                                    <label for="telefone">
                                        Telefone
                                    </label>

                                    <input type="tel" id="telefone" name="telefone" placeholder="(51) 99999-9999"
                                        minlength="10" maxlength="16" autocomplete="tel" required>
                                </div>

                            </div>

                            <div class="inputBox">
                                <label for="descricao">
                                    Descrição profissional
                                </label>

                                <textarea id="descricao" name="descricao" rows="4" minlength="20" maxlength="1000"
                                    placeholder="Conte um pouco sobre sua formação, experiência e áreas de atuação..."
                                    required></textarea>

                                <small class="ajudaCampo">
                                    Mínimo de 20 e máximo de 1000 caracteres.
                                </small>
                            </div>

                            <div class="inputBox">
                                <label for="foto">
                                    Foto de perfil
                                </label>

                                <input type="file" id="foto" name="foto" accept="image/jpeg,image/png,image/webp">

                                <small class="ajudaCampo">
                                    Formatos permitidos: JPG, PNG ou WebP.
                                </small>
                            </div>

                        </div>

                        <div class="grupoFormulario">

                            <div class="tituloGrupo">
                                <span>3</span>

                                <div>
                                    <h3>Segurança</h3>
                                    <p>Crie uma senha para acessar sua conta.</p>
                                </div>
                            </div>

                            <div class="duasColunas">

                                <div class="inputBox">
                                    <label for="senha">
                                        Senha
                                    </label>

                                    <input type="password" id="senha" name="senha" placeholder="Mínimo de 6 caracteres"
                                        minlength="6" maxlength="72" autocomplete="new-password" required>
                                </div>

                                <div class="inputBox">
                                    <label for="confirmarSenha">
                                        Confirmar senha
                                    </label>

                                    <input type="password" id="confirmarSenha" name="confirmarSenha"
                                        placeholder="Digite a senha novamente" minlength="6" maxlength="72"
                                        autocomplete="new-password" required>
                                </div>

                            </div>

                            <label class="mostrar">
                                <input type="checkbox" id="mostrarSenhas">

                                Mostrar senhas
                            </label>

                        </div>

                        <button type="submit" class="btn">
                            Solicitar cadastro
                        </button>

                    </form>

                    <div class="cadastro">
                        Já possui uma conta?

                        <a href="/login">
                            Entrar
                        </a>
                    </div>

                </div>

            </section>

        </div>

        <script>
            const mostrarSenhas =
                document.getElementById("mostrarSenhas");

            const senha =
                document.getElementById("senha");

            const confirmarSenha =
                document.getElementById("confirmarSenha");

            mostrarSenhas.addEventListener("change", () => {
                const tipo = mostrarSenhas.checked
                    ? "text"
                    : "password";

                senha.type = tipo;
                confirmarSenha.type = tipo;
            });

            const campoData =
                document.getElementById("data_nascimento");

            const hoje = new Date();

            const ano = hoje.getFullYear();

            const mes = String(
                hoje.getMonth() + 1
            ).padStart(2, "0");

            const dia = String(
                hoje.getDate()
            ).padStart(2, "0");

            campoData.max = `${ano}-${mes}-${dia}`;
        </script>

</body>

</html>