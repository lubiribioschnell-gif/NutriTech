<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NutriTech - Recuperar senha</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="pagina-autenticacao">
    <main class="auth-pagina-simples">
        <div class="auth-card-simples">
            <img src="/img/logo.png" alt="Logo NutriTech" class="auth-logo-simples">
            <span class="etiquetaAuth">Recuperação de conta</span>
            <h1>Esqueci minha senha</h1>
            <p class="subtituloAuth">Informe seu e-mail e enviaremos as instruções para criar uma nova senha.</p>

            <% if (erro) { %><div class="mensagem mensagem-erro"><%= erro %></div><% } %>
            <% if (sucesso) { %><div class="mensagem mensagem-sucesso"><%= sucesso %></div><% } %>

            <form action="/recuperar-senha" method="POST">
                <div class="inputBox">
                    <label for="email">E-mail</label>
                    <input id="email" type="email" name="email" placeholder="Digite seu e-mail" required autocomplete="email">
                </div>
                <button class="btn" type="submit">Enviar link de recuperação</button>
            </form>

            <p class="auth-link-voltar"><a href="/login">Voltar para o login</a></p>
        </div>
    </main>
</body>
</html>
