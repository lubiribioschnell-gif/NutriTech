                                    <path d="M100 100H174C174 141 140 174 100 174V100Z" fill="#CBE1D1" />

                                    <path d="M100 100V174C59 174 26 141 26 100H100Z" fill="#9FC7AA" />

                                    <path d="M100 100H26C26 59 59 26 100 26V100Z" fill="#E3D8B7" />

                                    <circle cx="100" cy="100" r="30" fill="#FFFFFF" />

                                    <path d="M88 103C94 111 106 111 112 103" stroke="#3C482F" stroke-width="4"
                                        stroke-linecap="round" />

                                    <circle cx="90" cy="91" r="3" fill="#3C482F" />

                                    <circle cx="110" cy="91" r="3" fill="#3C482F" />
                                </svg>

                            </div>

                        </div>

                        <div class="mini-cards">

                            <div class="mini-card">
                                <span class="mini-card-icone">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M4 20V10" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" />

                                        <path d="M10 20V4" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" />

                                        <path d="M16 20V13" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" />

                                        <path d="M22 20V7" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" />
                                    </svg>
                                </span>

                                <div>
                                    <strong>Diário alimentar</strong>
                                    <small>Acompanhe sua rotina</small>
                                </div>
                            </div>

                            <div class="mini-card">
                                <span class="mini-card-icone">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path
                                            d="M12 3L14.7 8.5L21 9.4L16.5 13.8L17.6 20L12 17.1L6.4 20L7.5 13.8L3 9.4L9.3 8.5L12 3Z"
                                            stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                    </svg>
                                </span>

                                <div>
                                    <strong>Sistema de pontos</strong>
                                    <small>Valorize sua evolução</small>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>
        </section>

        <section class="secao secao-passos" id="como-funciona">
            <div class="container">

                <div class="cabecalho-secao">
                    <span class="subtitulo-secao">
                        Como funciona
                    </span>

                    <h2>
                        Começar é simples
                    </h2>

                    <p>
                        Em poucos passos, você pode iniciar sua jornada
                        dentro do NutriTech.
                    </p>
                </div>

                <div class="linha-passos">

                    <article class="passo">
                        <span class="passo-numero">1</span>

                        <div class="passo-icone">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z"
                                    stroke="currentColor" stroke-width="1.8" />

                                <path d="M4 22C4 17.5817 7.58172 14 12 14C16.4183 14 20 17.5817 20 22"
                                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </div>

                        <h3>Crie sua conta</h3>

                        <p>
                            Cadastre-se como usuário ou nutricionista.
                        </p>
                    </article>

                    <span class="seta-passo" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

                            <path d="M13 6L19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round" />
                        </svg>
                    </span>

                    <article class="passo">
                        <span class="passo-numero">2</span>

                        <div class="passo-icone">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M16 21V19C16 16.7909 14.2091 15 12 15H6C3.79086 15 2 16.7909 2 19V21"
                                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />

                                <path
                                    d="M9 11C11.2091 11 13 9.20914 13 7C13 4.79086 11.2091 3 9 3C6.79086 3 5 4.79086 5 7C5 9.20914 6.79086 11 9 11Z"
                                    stroke="currentColor" stroke-width="1.8" />

                                <path d="M19 8V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />

                                <path d="M16 11H22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </div>

                        <h3>Escolha um nutricionista</h3>

                        <p>
                            Conheça os profissionais disponíveis.
                        </p>
                    </article>

                    <span class="seta-passo" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

                            <path d="M13 6L19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round" />
                        </svg>
                    </span>

                    <article class="passo">
                        <span class="passo-numero">3</span>

                        <div class="passo-icone">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="M21 15C21 16.1046 20.1046 17 19 17H8L3 21V5C3 3.89543 3.89543 3 5 3H19C20.1046 3 21 3.89543 21 5V15Z"
                                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                    stroke-linejoin="round" />

                                <path d="M8 8H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />

                                <path d="M8 12H13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </div>

                        <h3>Solicite acompanhamento</h3>

                        <p>
                            Envie sua solicitação ao profissional.
                        </p>
                    </article>

                    <span class="seta-passo" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

                            <path d="M13 6L19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round" />
                        </svg>
                    </span>

                    <article class="passo">
                        <span class="passo-numero">4</span>

                        <div class="passo-icone">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M4 7H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />

                                <path d="M6 4H18C19.1046 4 20 4.89543 20 6V20H4V6C4 4.89543 4.89543 4 6 4Z"
                                    stroke="currentColor" stroke-width="1.8" />

                                <path d="M8 11H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />

                                <path d="M8 15H14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </div>

                        <h3>Acompanhe sua rotina</h3>

                        <p>
                            Utilize os recursos e acompanhe sua evolução.
                        </p>
                    </article>

                </div>

            </div>
        </section>

        <section class="secao secao-beneficios" id="beneficios">
            <div class="container">

                <div class="cabecalho-secao">
                    <span class="subtitulo-secao">
                        Para todos
                    </span>

                    <h2>
                        Benefícios para usuários e nutricionistas
                    </h2>

                    <p>
                        A plataforma organiza as principais atividades
                        de cada perfil em ambientes simples e intuitivos.
                    </p>
                </div>

                <div class="grade-beneficios">

                    <article class="card-beneficio card-usuario">

                        <div class="beneficio-topo">
                            <div class="beneficio-icone">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path
                                        d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z"
                                        stroke="currentColor" stroke-width="1.8" />

                                    <path d="M4 22C4 17.5817 7.58172 14 12 14C16.4183 14 20 17.5817 20 22"
                                        stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                </svg>
                            </div>

                            <div>
                                <span>Para</span>
                                <h3>Usuários</h3>
                            </div>
                        </div>

                        <ul>
                            <li>
                                <span class="check">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
