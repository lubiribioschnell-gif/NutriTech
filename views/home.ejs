<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="NutriTech: educação alimentar, acompanhamento nutricional e hábitos saudáveis por meio da tecnologia.">

    <title>
        <%= typeof titulo !=="undefined" ? titulo : "NutriTech" %>
    </title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/publico.css">

</head>

<body>

    <header class="cabecalho" id="inicio">

        <%- include("partials/navbarPublica") %>

    </header>

    <main>

        <section class="hero">
            <div class="hero-container">

                <div class="hero-conteudo">

                    <span class="etiqueta">
                        Tecnologia e alimentação saudável
                    </span>

                    <h1>
                        Alimentação saudável
                        <span>começa com informação.</span>
                    </h1>

                    <p>
                        O NutriTech conecta usuários e nutricionistas em
                        uma plataforma criada para promover educação
                        alimentar, acompanhamento personalizado e hábitos
                        mais conscientes.
                    </p>

                    <div class="hero-acoes">
                        <a href="/escolherCadastro" class="botao botao-primario">
                            Começar agora

                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

                                <path d="M13 6L19 12L13 18" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>

                        <a href="#como-funciona" class="botao botao-secundario">
                            Conhecer a plataforma
                        </a>
                    </div>

                </div>

                <div class="hero-visual" aria-hidden="true">

                    <div class="circulo circulo-um"></div>
                    <div class="circulo circulo-dois"></div>

                    <div class="cartao-ilustracao">

                        <div class="ilustracao-topo">
                            <span>Minha rotina saudável</span>

                            <span class="status">
                                Ativo
                            </span>
                        </div>

                        <div class="prato">

                            <div class="prato-centro">

                                <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
