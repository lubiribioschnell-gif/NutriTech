        <section class="secao secao-chamada">
            <div class="container">

                <div class="chamada">

                    <div class="chamada-conteudo">
                        <span class="chamada-etiqueta">
                            Comece hoje
                        </span>

                        <h2>
                            Transforme informação em hábitos mais
                            conscientes.
                        </h2>

                        <p>
                            Crie sua conta e conheça as ferramentas do
                            NutriTech.
                        </p>

                        <div class="chamada-acoes">
                            <a href="/escolherCadastro" class="botao botao-claro">
                                Criar minha conta

                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"
                                    aria-hidden="true">
                                    <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

                                    <path d="M13 6L19 12L13 18" stroke="currentColor" stroke-width="2"
                                        stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </a>

                            <a href="/login" class="botao botao-contorno-claro">
                                Já tenho uma conta
                            </a>
                        </div>
                    </div>

                    <div class="chamada-visual" aria-hidden="true">
                        <svg viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="120" cy="120" r="95" stroke="currentColor" stroke-width="3"
