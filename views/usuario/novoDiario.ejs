<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %> - NutriTech</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/novoDiario.css">
</head>
<body>
    <%- include("../partials/mensagem") %>
    <%- include("../partials/navbarUsuario") %>

    <main class="container">
        <a href="/usuario/diario" class="voltar-diario">← Voltar para o diário</a>

        <section class="cabecalho-diario-form">
            <span>Diário alimentar</span>
            <h1>Fazer novo registro</h1>
            <p>Registre um alimento consumido e acompanhe sua alimentação diariamente.</p>
        </section>

        <section class="form-card">
            <% if (erro) { %>
                <div class="mensagem-erro"><%= erro %></div>
            <% } %>

            <form action="/usuario/diario" method="POST" class="formulario">
                <div class="campo">
                    <label for="alimento">Alimento</label>
                    <input type="text" id="alimento" name="alimento" maxlength="100"
                        value="<%= registro && registro.alimento ? registro.alimento : '' %>" required>
                </div>

                <div class="campo">
                    <label for="quantidade">Quantidade</label>
                    <input type="text" id="quantidade" name="quantidade" maxlength="50"
                        value="<%= registro && registro.quantidade ? registro.quantidade : '' %>"
                        placeholder="Ex.: 200 g, 1 unidade ou 1 prato" required>
                </div>

                <div class="campo">
                    <label for="observacoes">Observações</label>
                    <textarea id="observacoes" name="observacoes" maxlength="500"
                        placeholder="Ex.: consumido após o treino"><%= registro && registro.observacoes ? registro.observacoes : '' %></textarea>
                </div>

                <div class="form-actions">
                    <a href="/usuario/diario" class="btn-secundario">Cancelar</a>
                    <button type="submit" class="btn-primary">Salvar registro</button>
                </div>
            </form>
        </section>
    </main>
</body>
</html>
