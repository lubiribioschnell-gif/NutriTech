<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= titulo %> | NutriTech
    </title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/visualizarNutricionista.css">
</head>

<body>

    <%- include("../partials/navbarUsuario") %>

    <main class="pagina-nutricionista">

        <section class="hero-nutricionista">
            <div class="hero-conteudo">

                <span class="hero-etiqueta">
                    Nutricionista
                </span>

                <h1>Conheça o profissional</h1>

                <p>
                    Confira as informações do nutricionista antes
                    de solicitar o acompanhamento.
                </p>

            </div>

            <div class="hero-decoracao" aria-hidden="true">

                <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M91 22C58 22 32 40 25 68C20 87 34 99 52 93C78 84 91 56 91 22Z" stroke="currentColor"
                        stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />

                    <path d="M27 92C42 70 57 55 79 40" stroke="currentColor" stroke-width="5" stroke-linecap="round" />

                    <path d="M44 69C51 70 59 72 67 76" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
                </svg>

            </div>
        </section>

        <section class="conteudo-nutricionista">

            <article class="card-perfil">

                <div class="perfil-principal">

                    <div class="foto-container">

                        <% if (nutricionista.foto) { %>

                            <img src="/uploads/<%= nutricionista.foto %>" alt="Foto de <%= nutricionista.nome %>"
                                class="foto-nutricionista">

                            <% } else { %>

                                <div class="foto-sem-imagem" aria-label="Nutricionista sem foto">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path
                                            d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z"
                                            stroke="currentColor" stroke-width="1.8" />

                                        <path d="M3 22C3 17.5817 7.02944 14 12 14C16.9706 14 21 17.5817 21 22"
                                            stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    </svg>
                                </div>

                                <% } %>

                    </div>

                    <div class="identificacao">

                        <span class="identificacao-tipo">
                            Profissional de Nutrição
                        </span>

                        <h2>
                            <%= nutricionista.nome %>
                        </h2>

                        <div class="crn-destaque">

                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M9 11L11 13L15 9" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round" />

                                <path
                                    d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"
                                    stroke="currentColor" stroke-width="1.8" />
                            </svg>

                            <span>
                                CRN:
                                <strong>
                                    <%= nutricionista.crn || "Não informado" %>
                                </strong>
                            </span>

                        </div>

                    </div>

                </div>

                <div class="grade-informacoes">

                    <div class="informacao-item">

                        <div class="informacao-icone">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path
                                    d="M4 4H20C21.1046 4 22 4.89543 22 6V18C22 19.1046 21.1046 20 20 20H4C2.89543 20 2 19.1046 2 18V6C2 4.89543 2.89543 4 4 4Z"
                                    stroke="currentColor" stroke-width="1.8" />

                                <path d="M22 6L12 13L2 6" stroke="currentColor" stroke-width="1.8"
                                    stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>

                        <div>
                            <span class="informacao-label">E-mail</span>

                            <p>
                                <%= nutricionista.email || "Não informado" %>
                            </p>
                        </div>

                    </div>

                    <div class="informacao-item">

                        <div class="informacao-icone">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M6 3H15L20 8V21H6V3Z" stroke="currentColor" stroke-width="1.8"
                                    stroke-linejoin="round" />

                                <path d="M15 3V8H20" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />

                                <path d="M9 13H17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />

                                <path d="M9 17H15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </div>

                        <div>
                            <span class="informacao-label">
                                Certificado
                            </span>

                            <p>
                                <%= nutricionista.certificado || "Não informado" %>
                            </p>
                        </div>

                    </div>

                    <div class="informacao-item">

                        <div class="informacao-icone">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path
                                    d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z"
                                    stroke="currentColor" stroke-width="1.8" />

                                <path d="M4 22C4 17.5817 7.58172 14 12 14C16.4183 14 20 17.5817 20 22"
                                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </div>

                        <div>
                            <span class="informacao-label">Sexo</span>

                            <p>
                                <%= nutricionista.sexo || "Não informado" %>
                            </p>
                        </div>

                    </div>

                    <div class="informacao-item">

                        <div class="informacao-icone">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M7 2V5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />

                                <path d="M17 2V5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />

                                <path d="M3 9H21" stroke="currentColor" stroke-width="1.8" />

                                <path
                                    d="M5 4H19C20.1046 4 21 4.89543 21 6V20C21 21.1046 20.1046 22 19 22H5C3.89543 22 3 21.1046 3 20V6C3 4.89543 3.89543 4 5 4Z"
                                    stroke="currentColor" stroke-width="1.8" />
                            </svg>
                        </div>

                        <div>
                            <span class="informacao-label">
                                Data de nascimento
                            </span>

                            <p>
                                <% if (nutricionista.data_nascimento) { %>

                                    <%= new Date( nutricionista.data_nascimento ).toLocaleDateString( "pt-BR" , {
                                        timeZone: "UTC" } ) %>

                                        <% } else { %>

                                            Não informada

                                            <% } %>
                            </p>
                        </div>

                    </div>

                </div>

            </article>

            <article class="card-descricao">

                <div class="titulo-secao">

                    <div class="titulo-secao-icone">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path
                                d="M21 15C21 16.1046 20.1046 17 19 17H8L3 21V5C3 3.89543 3.89543 3 5 3H19C20.1046 3 21 3.89543 21 5V15Z"
                                stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <span>Apresentação</span>
                        <h2>Sobre o profissional</h2>
                    </div>

                </div>

                <div class="descricao-texto">

                    <% if (nutricionista.descricao) { %>

                        <p>
                            <%= nutricionista.descricao %>
                        </p>

                        <% } else { %>

                            <p class="descricao-vazia">
                                Este nutricionista ainda não adicionou uma
                                descrição profissional.
                            </p>

                            <% } %>

                </div>

            </article>

            <div class="acoes-perfil">

                <a href="/usuario/nutricionistas" class="botao botao-voltar">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M19 12H5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

                        <path d="M12 19L5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round" />
                    </svg>

                    Voltar
                </a>

                <form action="/usuario/nutricionistas/<%= nutricionista.id_nutricionista %>/solicitar" method="POST"
                    class="form-solicitacao">
                    <button type="submit" class="botao botao-solicitar">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M12 5V19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

                            <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>

                        Solicitar acompanhamento
                    </button>
                </form>

            </div>

        </section>

    </main>

</body>

</html>