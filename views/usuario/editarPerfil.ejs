<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>NutriTech - Editar Perfil</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/auth.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >
</head>

<body class="pagina-editar-usuario">

    <%- include("../partials/mensagem") %>

    <main class="editar-usuario-layout">

        <aside class="editar-usuario-lateral">

            <div class="editar-usuario-logo">

                <img
                    src="/img/logo.png"
                    alt="Logo NutriTech"
                >

                <span>Meu perfil</span>

                <h1>NutriTech</h1>

                <p>
                    Atualize seus dados pessoais e mantenha suas
                    informações sempre corretas.
                </p>

            </div>

        </aside>

        <section class="editar-usuario-conteudo">

            <div class="editar-usuario-formulario">

                <header class="editar-usuario-cabecalho">

                    <div>

                        <span class="editar-usuario-etiqueta">
                            Configurações da conta
                        </span>

                        <h2>Editar perfil</h2>

                        <p>
                            Atualize seus dados pessoais e informações
                            utilizadas no acompanhamento nutricional.
                        </p>

                    </div>

                    <a
                        href="/usuario/perfil"
                        class="editar-usuario-voltar-topo"
                    >
                        Voltar ao perfil
                    </a>

                </header>

                <% if (
                    typeof erro !== "undefined" &&
                    erro
                ) { %>

                    <div class="mensagem-erro">
                        <%= erro %>
                    </div>

                <% } %>

                <% if (usuario.foto) { %>

                    <div class="editar-usuario-foto-atual">

                        <img
                            src="/uploads/<%= usuario.foto %>"
                            alt="Foto de perfil de <%= usuario.nome %>"
                        >

                        <div>

                            <strong>Foto atual</strong>

                            <p>
                                Selecione outra imagem apenas caso deseje
                                alterar sua foto de perfil.
                            </p>

                        </div>

                    </div>

                <% } %>

                <form
                    action="/usuario/perfil/editar"
                    method="POST"
                    enctype="multipart/form-data"
                    class="editar-usuario-form"
                >

                    <section class="editar-usuario-secao">

                        <div class="editar-usuario-titulo-secao">

                            <span>01</span>

                            <div>
                                <h3>Informações pessoais</h3>
                                <p>Dados básicos da sua conta.</p>
                            </div>

                        </div>

                        <div class="editar-usuario-grade">

                            <div class="inputBox">

                                <label for="nome">
                                    Nome completo
                                </label>

                                <input
                                    type="text"
                                    id="nome"
                                    name="nome"
                                    value="<%= usuario.nome || '' %>"
                                    placeholder="Digite seu nome"
                                    maxlength="150"
                                    autocomplete="name"
                                    required
                                >

                            </div>

                            <div class="inputBox">

                                <label for="email">
                                    E-mail
                                </label>

                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    value="<%= usuario.email || '' %>"
                                    placeholder="Digite seu e-mail"
                                    maxlength="150"
                                    autocomplete="email"
                                    required
                                >

                            </div>

                            <div class="inputBox">

                                <label for="data_nascimento">
                                    Data de nascimento
                                </label>

                                <input
                                    type="date"
                                    id="data_nascimento"
                                    name="data_nascimento"
                                    value="<%=
                                        usuario.data_nascimento
                                            ? new Date(
                                                usuario.data_nascimento
                                            ).toISOString().split('T')[0]
                                            : ''
                                    %>"
                                    required
                                >

                            </div>

                            <div class="inputBox">

                                <label for="sexo">
                                    Sexo
                                </label>

                                <select
                                    id="sexo"
                                    name="sexo"
                                    required
                                >

                                    <option value="">
                                        Selecione
                                    </option>

                                    <option
                                        value="Masculino"
                                        <%= usuario.sexo === "Masculino"
                                            ? "selected"
                                            : ""
                                        %>
                                    >
                                        Masculino
                                    </option>

                                    <option
                                        value="Feminino"
                                        <%= usuario.sexo === "Feminino"
                                            ? "selected"
                                            : ""
                                        %>
                                    >
                                        Feminino
                                    </option>

                                    <option
                                        value="Outro"
                                        <%= usuario.sexo === "Outro"
                                            ? "selected"
                                            : ""
                                        %>
                                    >
                                        Prefiro não informar
                                    </option>

                                </select>

                            </div>

                        </div>

                    </section>

                    <section class="editar-usuario-secao">

                        <div class="editar-usuario-titulo-secao">

                            <span>02</span>

                            <div>
                                <h3>Informações corporais</h3>
                                <p>
                                    Dados utilizados no cálculo e
                                    acompanhamento nutricional.
                                </p>
                            </div>

                        </div>

                        <div class="editar-usuario-grade">

                            <div class="inputBox">

                                <label for="peso">
                                    Peso
                                </label>

                                <div class="editar-usuario-campo-unidade">

                                    <input
                                        type="number"
                                        id="peso"
                                        name="peso"
                                        step="0.1"
                                        min="1"
                                        value="<%= usuario.peso || '' %>"
                                        placeholder="Ex.: 70"
                                        required
                                    >

                                    <span>kg</span>

                                </div>

                            </div>

                            <div class="inputBox">

                                <label for="altura">
                                    Altura
                                </label>

                                <div class="editar-usuario-campo-unidade">

                                    <input
                                        type="number"
                                        id="altura"
                                        name="altura"
                                        step="0.01"
                                        min="0.5"
                                        max="3"
                                        value="<%= usuario.altura || '' %>"
                                        placeholder="Ex.: 1,75"
                                        required
                                    >

                                    <span>m</span>

                                </div>

                            </div>

                        </div>

                    </section>

                    <section class="editar-usuario-secao">

                        <div class="editar-usuario-titulo-secao">

                            <span>03</span>

                            <div>
                                <h3>Foto de perfil</h3>
                                <p>Atualize a imagem exibida em sua conta.</p>
                            </div>

                        </div>

                        <div class="inputBox editar-usuario-campo-completo">

                            <button
                                type="button"
                                class="editar-usuario-upload"
                                id="abrirSeletorFoto"
                            >

                                <svg
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                >
                                    <path d="M12 16V4"></path>
                                    <path d="m7 9 5-5 5 5"></path>
                                    <path d="M5 20h14"></path>
                                </svg>

                                <div>

                                    <strong>Selecionar nova foto</strong>

                                    <span>
                                        JPEG, PNG ou WEBP
                                    </span>

                                </div>

                            </button>

                            <input
                                type="file"
                                id="foto"
                                name="foto"
                                accept="image/jpeg,image/png,image/webp"
                                class="editar-usuario-input-arquivo"
                                aria-describedby="ajudaFoto"
                            >

                            <small id="ajudaFoto">
                                JPG, PNG ou WEBP • máximo de 5 MB. Deixe vazio para manter a foto atual.
                            </small>

                            <p id="nomeArquivoFoto" class="editar-usuario-arquivo"></p>

                            <div id="previewFoto" class="editar-usuario-preview-foto" hidden>
                                <img id="imagemPreviewFoto" src="" alt="Pré-visualização da nova foto">
                            </div>

                        </div>

                    </section>

                    <div class="editar-usuario-acoes">

                        <a
                            href="/usuario/perfil"
                            class="editar-usuario-cancelar"
                        >
                            Cancelar
                        </a>

                        <button
                            type="submit"
                            class="editar-usuario-salvar"
                        >
                            Salvar alterações
                        </button>

                    </div>

                </form>

            </div>

        </section>

    </main>

    <script>
        (() => {
            const campoFoto = document.getElementById("foto");
            const nomeArquivoFoto = document.getElementById("nomeArquivoFoto");
            const previewFoto = document.getElementById("previewFoto");
            const imagemPreviewFoto = document.getElementById("imagemPreviewFoto");

            const abrirSeletor = document.getElementById("abrirSeletorFoto");

            if (!campoFoto || !abrirSeletor) return;

            abrirSeletor.addEventListener("click", () => {
                campoFoto.click();
            });

            campoFoto.addEventListener("change", () => {
                const arquivo = campoFoto.files && campoFoto.files[0];

                if (!arquivo) {
                    nomeArquivoFoto.textContent = "";
                    previewFoto.hidden = true;
                    imagemPreviewFoto.removeAttribute("src");
                    return;
                }

                const tiposPermitidos = ["image/jpeg", "image/png", "image/webp"];
                const tamanhoMaximo = 5 * 1024 * 1024;

                if (!tiposPermitidos.includes(arquivo.type)) {
                    alert("Selecione uma imagem JPG, PNG ou WEBP.");
                    campoFoto.value = "";
                    nomeArquivoFoto.textContent = "";
                    previewFoto.hidden = true;
                    return;
                }

                if (arquivo.size > tamanhoMaximo) {
                    alert("A foto deve ter no máximo 5 MB.");
                    campoFoto.value = "";
                    nomeArquivoFoto.textContent = "";
                    previewFoto.hidden = true;
                    return;
                }

                nomeArquivoFoto.textContent =
                    `Arquivo selecionado: ${arquivo.name}`;

                const leitor = new FileReader();
                leitor.onload = evento => {
                    imagemPreviewFoto.src = evento.target.result;
                    previewFoto.hidden = false;
                };
                leitor.readAsDataURL(arquivo);
            });
        })();
    </script>

</body>

</html>