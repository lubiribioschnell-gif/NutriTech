<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= titulo %> - NutriTech
    </title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/alimentosRefeicao.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <%- include("../partials/mensagem") %>
        <%- include("../partials/navbarNutricionista") %>

            <main class="paginaCardapio">

                <a href="/nutricionista/cardapios/<%= refeicao.id_cardapio %>/refeicoes" class="voltar">
                    ← Voltar para as refeições
                </a>

                <section class="cabecalhoPagina">

                    <span>
                        <%= refeicao.nome_cardapio %>
                    </span>

                    <h1>
                        <%= refeicao.tipo %>
                    </h1>

                    <p>
                        Cardápio de
                        <strong>
                            <%= refeicao.nome_usuario %>
                        </strong>
                    </p>

                </section>

                <% if (sucesso) { %>
                    <div class="mensagemSucesso">
                        <%= sucesso %>
                    </div>
                    <% } %>

                        <section class="gradeAlimentos">

                            <div class="cardFormulario">

                                <h2>Adicionar alimento existente</h2>

                                <% if (alimentos.length===0) { %>

                                    <p class="textoApoio">
                                        Ainda não existem alimentos cadastrados.
                                        Cadastre um alimento novo ao lado.
                                    </p>

                                    <% } else { %>

                                        <form action="/nutricionista/refeicoes/<%= refeicao.id_refeicao %>/alimentos"
                                            method="POST">

                                            <div class="campo">

                                                <label for="id_alimento">
                                                    Alimento
                                                </label>

                                                <select id="id_alimento" name="id_alimento" required>
                                                    <option value="">
                                                        Selecione um alimento
                                                    </option>

                                                    <% alimentos.forEach(alimento=> { %>

                                                        <option value="<%= alimento.id_alimento %>">
                                                            <%= alimento.nome %>
                                                                — <%= Number(alimento.calorias).toFixed(0) %> kcal
                                                        </option>

                                                        <% }) %>

                                                </select>

                                            </div>

                                            <div class="campo">

                                                <label for="quantidadeExistente">
                                                    Quantidade
                                                </label>

                                                <input type="text" id="quantidadeExistente" name="quantidade"
                                                    placeholder="Ex.: 100 g, 1 unidade, 200 ml" maxlength="100"
                                                    required>

                                            </div>

                                            <button type="submit" class="botaoSalvar">
                                                Adicionar à refeição
                                            </button>

                                        </form>

                                        <% } %>

                            </div>

                            <div class="cardFormulario">

                                <h2>Cadastrar alimento novo</h2>

                                <form action="/nutricionista/refeicoes/<%= refeicao.id_refeicao %>/alimentos/novo"
                                    method="POST">

                                    <div class="campo">

                                        <label for="nome">
                                            Nome do alimento
                                        </label>

                                        <input type="text" id="nome" name="nome" placeholder="Ex.: Arroz integral"
                                            maxlength="100" required>

                                    </div>

                                    <div class="campo">

                                        <label for="quantidadeNova">
                                            Quantidade na refeição
                                        </label>

                                        <input type="text" id="quantidadeNova" name="quantidade"
                                            placeholder="Ex.: 100 g" maxlength="100" required>

                                    </div>

                                    <div class="gradeNutrientes">

                                        <div class="campo">
                                            <label for="calorias">Calorias</label>

                                            <input type="number" id="calorias" name="calorias" min="0" step="0.01"
                                                value="0">
                                        </div>

                                        <div class="campo">
                                            <label for="proteinas">Proteínas</label>

                                            <input type="number" id="proteinas" name="proteinas" min="0" step="0.01"
                                                value="0">
                                        </div>

                                        <div class="campo">
                                            <label for="carboidratos">
                                                Carboidratos
                                            </label>

                                            <input type="number" id="carboidratos" name="carboidratos" min="0"
                                                step="0.01" value="0">
                                        </div>

                                        <div class="campo">
                                            <label for="gorduras">Gorduras</label>

                                            <input type="number" id="gorduras" name="gorduras" min="0" step="0.01"
                                                value="0">
                                        </div>

                                    </div>

                                    <button type="submit" class="botaoSalvar">
                                        Cadastrar e adicionar
                                    </button>

                                </form>

                            </div>

                        </section>

                        <section class="listaAlimentos">

                            <div class="tituloLista">

                                <div>
                                    <span>Itens cadastrados</span>
                                    <h2>Alimentos da refeição</h2>
                                </div>

                                <strong>
                                    <%= itens.length %>
                                        <%= itens.length===1 ? "item" : "itens" %>
                                </strong>

                            </div>

                            <% if (itens.length===0) { %>

                                <div class="estadoVazio">

                                    <h3>Nenhum alimento adicionado</h3>

                                    <p>
                                        Utilize um dos formulários acima para montar
                                        esta refeição.
                                    </p>

                                </div>

                                <% } else { %>

                                    <div class="tabelaResponsiva">

                                        <table class="tabelaAlimentos">

                                            <thead>
                                                <tr>
                                                    <th>Alimento</th>
                                                    <th>Quantidade</th>
                                                    <th>Calorias</th>
                                                    <th>Proteínas</th>
                                                    <th>Carboidratos</th>
                                                    <th>Gorduras</th>
                                                    <th>Ações</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                <% itens.forEach(item=> { %>
                                                    <tr>
                                                        <td>
                                                            <strong>
                                                                <%= item.nome %>
                                                            </strong>
                                                        </td>

                                                        <td>
                                                            <form
                                                                action="/nutricionista/itens-refeicao/<%= item.id_item %>/editar"
                                                                method="POST" class="form-quantidade">
                                                                <input type="text" name="quantidade"
                                                                    value="<%= item.quantidade %>" maxlength="100"
                                                                    required>

                                                                <button type="submit" class="botao-salvar-quantidade">
                                                                    Salvar
                                                                </button>
                                                            </form>
                                                        </td>

                                                        <td>
                                                            <%= Number(item.calorias).toFixed(1) %> kcal
                                                        </td>

                                                        <td>
                                                            <%= Number(item.proteinas).toFixed(1) %> g
                                                        </td>

                                                        <td>
                                                            <%= Number(item.carboidratos).toFixed(1) %> g
                                                        </td>

                                                        <td>
                                                            <%= Number(item.gorduras).toFixed(1) %> g
                                                        </td>

                                                        <td>
                                                            <div class="acoes-alimento">
                                                                <a href="/nutricionista/alimentos/<%= item.id_alimento %>/editar"
                                                                    class="botao-editar-alimento">
                                                                    Editar
                                                                </a>

                                                                <form
                                                                    action="/nutricionista/itens-refeicao/<%= item.id_item %>/remover"
                                                                    method="POST"
                                                                    onsubmit="return confirm('Remover este alimento da refeição?')">
                                                                    <button type="submit"
                                                                        class="botao-remover-alimento">
                                                                        Remover
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                            </tbody>

                                            <tfoot>

                                                <tr>

                                                    <td colspan="2">
                                                        <strong>Total nutricional</strong>
                                                    </td>

                                                    <td>
                                                        <strong>
                                                            <%= itens .reduce( (total, item)=>
                                                                total + Number(item.calorias),
                                                                0
                                                                )
                                                                .toFixed(1) %>
                                                                kcal
                                                        </strong>
                                                    </td>

                                                    <td>
                                                        <strong>
                                                            <%= itens .reduce( (total, item)=>
                                                                total + Number(item.proteinas),
                                                                0
                                                                )
                                                                .toFixed(1) %>
                                                                g
                                                        </strong>
                                                    </td>

                                                    <td>
                                                        <strong>
                                                            <%= itens .reduce( (total, item)=>
                                                                total + Number(item.carboidratos),
                                                                0
                                                                )
                                                                .toFixed(1) %>
                                                                g
                                                        </strong>
                                                    </td>

                                                    <td>
                                                        <strong>
                                                            <%= itens .reduce( (total, item)=>
                                                                total + Number(item.gorduras),
                                                                0
                                                                )
                                                                .toFixed(1) %>
                                                                g
                                                        </strong>
                                                    </td>

                                                    <td></td>

                                                </tr>

                                            </tfoot>

                                        </table>

                                    </div>

                                    <% } %>

                        </section>

            </main>

</body>

</html>