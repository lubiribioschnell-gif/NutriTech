<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NutriTech - Editar Cardápio</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/editarAlimento.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"rel="stylesheet">
</head>

<body>
    <%- include("../partials/mensagem") %>
        <%- include("../partials/navbarNutricionista") %>

            <main class="paginaFormulario">

                <a href="/nutricionista/cardapios" class="voltar">
                    ← Voltar
                </a>

                <section class="cardFormulario">

                    <h1>Editar cardápio</h1>

                    <p class="subtituloPagina">
                        Atualize os dados principais do cardápio.
                    </p>

                    <% if (erro) { %>

                        <p class="mensagem-erro">
                            <%= erro %>
                        </p>

                        <% } %>

                            <form action="/nutricionista/cardapios/<%= cardapio.id_cardapio %>/editar" method="POST">

                                <div class="inputBox">

                                    <label for="id_usuario">
                                        Paciente
                                    </label>

                                    <select id="id_usuario" name="id_usuario" required>

                                        <option value="">
                                            Selecione um paciente
                                        </option>

                                        <% usuarios.forEach(paciente=> { %>

                                            <option value="<%= paciente.id_usuario %>"
                                                <%=String(cardapio.id_usuario)===String(paciente.id_usuario)
                                                ? "selected" : "" %>
                                                >
                                                <%= paciente.nome %>
                                                    — <%= paciente.email %>
                                            </option>

                                            <% }) %>

                                    </select>

                                </div>

                                <div class="inputBox">

                                    <label for="nome">
                                        Nome do cardápio
                                    </label>

                                    <input type="text" id="nome" name="nome" value="<%= cardapio.nome || '' %>"
                                        placeholder="Ex.: Cardápio semanal" required>

                                </div>

                                <div class="inputBox">

                                    <label for="observacoes">
                                        Observações
                                    </label>

                                    <textarea id="observacoes" name="observacoes" rows="6"
                                        placeholder="Orientações e observações nutricionais"><%= cardapio.observacoes || '' %></textarea>

                                </div>

                                <div class="acoes-formulario">

                                    <a href="/nutricionista/cardapios/<%= cardapio.id_cardapio %>/refeicoes"
                                        class="btn btn-voltar">
                                        Cancelar
                                    </a>

                                    <button type="submit" class="btn">
                                        Salvar alterações
                                    </button>
                                    <hr>

                                    <form action="/nutricionista/cardapios/<%= cardapio.id_cardapio %>/excluir"
                                        method="POST" onsubmit="return confirmarExclusao()">
                                    </form>
                                </div>

                            </form>
                            <form action="/nutricionista/cardapios/<%= cardapio.id_cardapio %>/excluir" method="POST"
                                onsubmit="return confirmarExclusao()">
                                <button type="submit" class="btn btn-danger">
                                    Excluir cardápio
                                </button>
                            </form>
                </section>

            </main>

</body>
<script>

    function confirmarExclusao() {

        return confirm(
            "Deseja realmente excluir este cardápio?\n\nEssa ação não poderá ser desfeita."
        );

    }

</script>

</html>