<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= titulo %> - NutriTech
    </title>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>
    <%- include("../partials/mensagem") %>
        <%- include("../partials/navbarNutricionista") %>

            <main class="dashboard">
                <section class="dashboard-apresentacao">
                    <div class="apresentacao-conteudo">
                        <span class="apresentacao-tag">Área profissional</span>

                        <h1>Olá, <%= usuario.nome %>!</h1>

                        <p>
                            Gerencie seus pacientes, acompanhe registros alimentares
                            e crie orientações personalizadas em um único lugar.
                        </p>

                        <div class="apresentacao-acoes">
                            <a href="/nutricionista/cardapios/novo" class="botao-dashboard botao-claro">
                                Criar cardápio
                            </a>

                            <a href="/nutricionista/pacientes" class="link-apresentacao">
                                Ver pacientes <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </div>

                    <div class="apresentacao-perfil" aria-hidden="true">
                        <div class="perfil-circulo">
                            <%= usuario.nome ? usuario.nome.trim().charAt(0).toUpperCase() : "N" %>
                        </div>
                        <span>Painel profissional NutriTech</span>
                    </div>
                </section>

                <section class="secao-dashboard">
                    <div class="titulo-secao">
                        <div>
                            <span>Visão geral</span>
                            <h2>Resumo profissional</h2>
                        </div>

                        <p>Dados dos seus acompanhamentos</p>
                    </div>

                    <div class="grade-resumo grade-resumo-profissional">
                        <article class="card-resumo">
                            <div class="card-resumo-topo">
                                <div class="card-resumo-icone" aria-hidden="true">
                                    <i data-lucide="user"></i>
                                </div>
                                <span class="card-resumo-status">Pacientes</span>
                            </div>

                            <strong>
                                <%= resumo.usuarios || 0 %>
                            </strong>

                            <p>
                                <%= (resumo.usuarios || 0)===1 ? "usuário acompanhado" : "usuários acompanhados" %>
                            </p>

                            <a href="/nutricionista/pacientes" class="card-resumo-link">
                                Visualizar <span aria-hidden="true">→</span>
                            </a>
                        </article>

                        <article class="card-resumo">
                            <div class="card-resumo-topo">
                                <div class="card-resumo-icone" aria-hidden="true">
                                    <i data-lucide="utensils"></i>
                                </div>
                                <span class="card-resumo-status">Cardápios</span>
                            </div>

                            <strong>
                                <%= resumo.cardapios || 0 %>
                            </strong>

                            <p>
                                <%= (resumo.cardapios || 0)===1 ? "cardápio criado" : "cardápios criados" %>
                            </p>

                            <a href="/nutricionista/cardapios/novo" class="card-resumo-link">
                                Criar novo <span aria-hidden="true">→</span>
                            </a>
                        </article>

                        <article class="card-resumo">
                            <div class="card-resumo-topo">
                                <div class="card-resumo-icone" aria-hidden="true">
                                    <i data-lucide="chef-hat"></i>
                                </div>

                                <span class="card-resumo-status">Refeições</span>
                            </div>


                            <strong>
                                <%= resumo.refeicoes || 0 %>
                            </strong>

                            <p>
                                <%= (resumo.refeicoes || 0)===1 ? "refeição cadastrada" : "refeições cadastradas" %>
                            </p>

                            <span class="card-resumo-link card-resumo-texto">
                                Conteúdo dos cardápios
                            </span>
                        </article>

                        <article class="card-resumo card-resumo-destaque">
                            <div class="card-resumo-topo">
                                <div class="card-resumo-icone" aria-hidden="true">
                                    <i data-lucide="clipboard-list"></i>
                                </div>
                                <span class="card-resumo-status">Quizzes</span>
                            </div>

                            <strong>
                                <%= resumo.quizzes || 0 %>
                            </strong>

                            <p>
                                <%= (resumo.quizzes || 0)===1 ? "quiz criado" : "quizzes criados" %>
                            </p>

                            <a href="/nutricionista/quizzes/novo" class="card-resumo-link">
                                Gerenciar <span aria-hidden="true">→</span>
                            </a>
                        </article>
                    </div>
                </section>

                <section class="secao-dashboard">
                    <div class="titulo-secao">
                        <div>
                            <span>Gerenciamento</span>
                            <h2>Acesso rápido</h2>
                        </div>

                        <p>Escolha uma funcionalidade para continuar</p>
                    </div>

                    <div class="grade-atalhos">
                        <a href="/nutricionista/cardapios/novo" class="card-atalho">
                            <div class="atalho-icone" aria-hidden="true">
                                <i data-lucide="utensils"></i>
                            </div>

                            <div class="atalho-conteudo">
                                <h3>Criar novo cardápio</h3>
                                <p>Escolha um paciente e monte um cardápio alimentar personalizado.</p>
                            </div>

                            <span class="atalho-seta" aria-hidden="true">→</span>
                        </a>

                        <a href="/nutricionista/pacientes" class="card-atalho">
                            <div class="atalho-icone" aria-hidden="true">
                                <i data-lucide="users"></i>
                            </div>

                            <div class="atalho-conteudo">
                                <h3>Meus pacientes</h3>
                                <p>Consulte os usuários acompanhados e acesse seus dados.</p>
                            </div>

                            <span class="atalho-seta" aria-hidden="true">→</span>
                        </a>

                        <a href="/nutricionista/pacientes" class="card-atalho">
                            <div class="atalho-icone" aria-hidden="true">
                                <i data-lucide="book-open"></i>
                            </div>

                            <div class="atalho-conteudo">
                                <h3>Diários alimentares</h3>
                                <p>Escolha um paciente para acompanhar seus registros alimentares.</p>
                            </div>

                            <span class="atalho-seta" aria-hidden="true">→</span>
                        </a>

                        <a href="/nutricionista/quizzes/novo" class="card-atalho">
                            <div class="atalho-icone" aria-hidden="true">
                                <i data-lucide="clipboard-list"></i>
                            </div>

                            <div class="atalho-conteudo">
                                <h3>Gerenciar quizzes</h3>
                                <p>Crie perguntas e acompanhe o desempenho dos pacientes.</p>
                            </div>

                            <span class="atalho-seta" aria-hidden="true">→</span>
                        </a>

                        <a href="/nutricionista/solicitacoes" class="card-atalho">
                            <div class="atalho-icone">
                                <i data-lucide="user-plus"></i>
                            </div>
                            <div class="atalho-conteudo">
                                <h3>Solicitações</h3>
                                <p>Aceite ou recuse pedidos de acompanhamento.</p>
                            </div>

                            <span class="atalho-seta" aria-hidden="true">→</span>

                        </a>

                    </div> <!-- fecha grade-atalhos -->

                </section>

                <section class="dashboard-banner">
                    <div class="dashboard-banner-icone" aria-hidden="true">
                        <i data-lucide="stethoscope"></i>
                    </div>

                    <div class="dashboard-banner-conteudo">
                        <span>Acompanhamento personalizado</span>
                        <h3>Ajude seus pacientes a construir hábitos mais saudáveis</h3>

                        <p>
                            Monte cardápios, acompanhe registros alimentares e ofereça
                            orientações adequadas para cada paciente.
                        </p>
                    </div>

                    <a href="/nutricionista/cardapios/novo" class="botao-dashboard">
                        Novo cardápio
                    </a>
                </section>
            </main>
            <script src="https://unpkg.com/lucide@latest"></script>

            <script>
                lucide.createIcons();
            </script>
</body>

</html>