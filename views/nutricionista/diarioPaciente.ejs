<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= titulo %> - NutriTech
    </title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/diarioPaciente.css">
</head>

<body>

    <%- include("../partials/mensagem") %>
        <%- include("../partials/navbarNutricionista") %>

            <main class="diario-paciente-container">

                <section class="diario-paciente-hero">

                    <div class="diario-paciente-hero-conteudo">

                        <span class="diario-paciente-tag">
                            Acompanhamento alimentar
                        </span>

                        <h1>Diário do paciente</h1>

                        <p>
                            Acompanhe os registros alimentares de
                            <strong>
                                <%= usuario.nome %>
                            </strong> e observe a frequência
                            de preenchimento durante os últimos sete dias.
                        </p>

                        <div class="diario-paciente-hero-acoes">

                            <a href="/nutricionista/pacientes"
                                class="diario-paciente-botao diario-paciente-botao-claro">
                                <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m15 18-6-6 6-6"></path>
                                </svg>

                                Voltar para pacientes
                            </a>

                        </div>

                    </div>

                    <div class="diario-paciente-hero-ilustracao" aria-hidden="true">

                        <div class="diario-paciente-hero-circulo">

                            <svg viewBox="0 0 24 24" width="72" height="72" fill="none" stroke="currentColor"
                                stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                                <path d="M14 2v6h6"></path>
                                <path d="M8 13h8"></path>
                                <path d="M8 17h6"></path>
                                <path d="M8 9h2"></path>
                            </svg>

                        </div>

                    </div>

                </section>

                <section class="diario-paciente-resumo">

                    <article class="diario-paciente-resumo-card">

                        <div class="diario-paciente-resumo-icone">

                            <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M8 2v4"></path>
                                <path d="M16 2v4"></path>
                                <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                                <path d="M3 10h18"></path>
                            </svg>

                        </div>

                        <div>
                            <span>Período do gráfico</span>
                            <strong>Últimos 7 dias</strong>
                        </div>

                    </article>

                    <article class="diario-paciente-resumo-card">

                        <div class="diario-paciente-resumo-icone">

                            <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                                <path d="M14 2v6h6"></path>
                                <path d="M8 13h8"></path>
                                <path d="M8 17h5"></path>
                            </svg>

                        </div>

                        <div>
                            <span>Total de registros</span>

                            <strong>
                                <%= registros ? registros.length : 0 %>
                            </strong>
                        </div>

                    </article>

                    <article class="diario-paciente-resumo-card">

                        <div class="diario-paciente-resumo-icone">

                            <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 6v6l4 2"></path>
                            </svg>

                        </div>

                        <div>
                            <span>Paciente</span>
                            <strong>
                                <%= usuario.nome %>
                            </strong>
                        </div>

                    </article>

                </section>

                <section class="diario-paciente-grafico-card">

                    <div class="diario-paciente-secao-cabecalho">

                        <div class="diario-paciente-secao-titulo">

                            <div class="diario-paciente-secao-icone">

                                <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 3v18h18"></path>
                                    <path d="M7 16v-5"></path>
                                    <path d="M12 16V8"></path>
                                    <path d="M17 16V5"></path>
                                </svg>

                            </div>

                            <div>
                                <span>Visão semanal</span>
                                <h2>Registros dos últimos 7 dias</h2>

                                <p>
                                    Quantidade de registros alimentares realizados
                                    diariamente pelo paciente.
                                </p>
                            </div>

                        </div>

                        <% if (grafico && grafico.length> 0) { %>

                            <span class="diario-paciente-status">
                                <span></span>
                                Dados disponíveis
                            </span>

                            <% } %>

                    </div>

                    <% if (!grafico || grafico.length===0) { %>

                        <div class="diario-paciente-grafico-vazio">

                            <div class="diario-paciente-vazio-icone">

                                <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor"
                                    stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 3v18h18"></path>
                                    <path d="M7 16v-3"></path>
                                    <path d="M12 16v-6"></path>
                                    <path d="M17 16v-9"></path>
                                </svg>

                            </div>

                            <h3>Sem dados para o gráfico</h3>

                            <p>
                                Não há registros alimentares nos últimos sete dias.
                            </p>

                        </div>

                        <% } else { %>

                            <div class="diario-paciente-grafico-container">
                                <canvas id="graficoDiario"></canvas>
                            </div>

                            <% } %>

                </section>

                <section class="diario-paciente-registros">

                    <div class="diario-paciente-lista-cabecalho">

                        <div>
                            <span>Histórico alimentar</span>
                            <h2>Registros alimentares</h2>

                            <p>
                                Consulte os alimentos, as quantidades e as observações
                                informadas pelo paciente.
                            </p>
                        </div>

                        <% if (registros && registros.length> 0) { %>

                            <div class="diario-paciente-contador">

                                <strong>
                                    <%= registros.length %>
                                </strong>

                                <span>
                                    <%= registros.length===1 ? "registro" : "registros" %>
                                </span>

                            </div>

                            <% } %>

                    </div>

                    <% if (!registros || registros.length===0) { %>

                        <div class="diario-paciente-vazio">

                            <div class="diario-paciente-vazio-icone">

                                <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor"
                                    stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                                    <path d="M14 2v6h6"></path>
                                    <path d="M9 15h6"></path>
                                </svg>

                            </div>

                            <h3>Nenhum registro encontrado</h3>

                            <p>
                                Este paciente ainda não realizou nenhum registro
                                no diário alimentar.
                            </p>

                        </div>

                        <% } else { %>

                            <div class="diario-paciente-lista">

                                <% registros.forEach((registro, index)=> { %>

                                    <article class="diario-paciente-card">

                                        <header class="diario-paciente-card-topo">

                                            <div class="diario-paciente-card-identificacao">

                                                <div class="diario-paciente-card-numero">
                                                    <%= index + 1 %>
                                                </div>

                                                <div>

                                                    <span>Registro alimentar</span>

                                                    <h3>
                                                        <%= registro.alimento %>
                                                    </h3>

                                                </div>

                                            </div>

                                            <span class="diario-paciente-data">

                                                <svg viewBox="0 0 24 24" width="17" height="17" fill="none"
                                                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                    stroke-linejoin="round">
                                                    <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                                                    <path d="M16 2v4"></path>
                                                    <path d="M8 2v4"></path>
                                                    <path d="M3 10h18"></path>
                                                </svg>

                                                <%= new Date( registro.data_registro ).toLocaleDateString("pt-BR") %>

                                            </span>

                                        </header>

                                        <div class="diario-paciente-card-conteudo">

                                            <div class="diario-paciente-quantidade">

                                                <div class="diario-paciente-info-icone">

                                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"
                                                        stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                        stroke-linejoin="round">
                                                        <path d="M4 19h16"></path>
                                                        <path d="M5 19 3 7h18l-2 12"></path>
                                                        <path d="M9 7a3 3 0 0 1 6 0"></path>
                                                    </svg>

                                                </div>

                                                <div>
                                                    <span>Quantidade informada</span>
                                                    <strong>
                                                        <%= registro.quantidade %>
                                                    </strong>
                                                </div>

                                            </div>

                                            <% if (registro.observacoes) { %>

                                                <div class="diario-paciente-observacoes">

                                                    <div class="diario-paciente-observacoes-titulo">

                                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                                            stroke="currentColor" stroke-width="2"
                                                            stroke-linecap="round" stroke-linejoin="round">
                                                            <path
                                                                d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z">
                                                            </path>
                                                        </svg>

                                                        <strong>Observações</strong>

                                                    </div>

                                                    <p>
                                                        <%= registro.observacoes %>
                                                    </p>

                                                </div>

                                                <% } %>

                                        </div>

                                    </article>

                                    <% }) %>

                            </div>

                            <% } %>

                </section>

            </main>

          <% if (grafico && grafico.length > 0) { %>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const labels = <%- JSON.stringify(
            grafico.map(item => {
                return new Date(item.dia).toLocaleDateString("pt-BR", {
                    timeZone: "UTC"
                });
            })
        ) %>;

        const dados = <%- JSON.stringify(
            grafico.map(item => {
                return Number(item.total);
            })
        ) %>;

        const canvas = document.getElementById("graficoDiario");

        if (canvas) {
            const contexto = canvas.getContext("2d");

            new Chart(contexto, {
                type: "bar",

                data: {
                    labels: labels,

                    datasets: [
                        {
                            label: "Quantidade de registros",
                            data: dados,
                            backgroundColor: "#9FC7AA",
                            borderColor: "#3C482F",
                            borderWidth: 1
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            display: true
                        }
                    },

                    scales: {
                        y: {
                            beginAtZero: true,

                            ticks: {
                                precision: 0,
                                stepSize: 1
                            }
                        }
                    }
                }
            });
        }
    </script>

<% } %>

</body>

</html>