<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= titulo %> - NutriTech
    </title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/quizNutricionista.css">
</head>

<body>

    <%- include("../partials/mensagem") %>
        <%- include("../partials/navbarNutricionista") %>

            <main class="quiz-nutri-container">

                <section class="quiz-nutri-hero">

                    <div class="quiz-nutri-hero-conteudo">

                        <span class="quiz-nutri-tag">
                            Atividades nutricionais
                        </span>

                        <h1>Gerenciamento de quizzes</h1>

                        <p>
                            Crie atividades personalizadas, organize perguntas e
                            acompanhe o desempenho dos seus pacientes.
                        </p>

                        <a href="/nutricionista/quizzes/novo" class="quiz-nutri-botao quiz-nutri-botao-claro">
                            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 5v14"></path>
                                <path d="M5 12h14"></path>
                            </svg>

                            Criar novo quiz
                        </a>

                    </div>

                    <div class="quiz-nutri-hero-icone" aria-hidden="true">

                        <svg viewBox="0 0 24 24" width="58" height="58" fill="none" stroke="currentColor"
                            stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 11l3 3L22 4"></path>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                        </svg>

                    </div>

                </section>

                <% if (sucesso) { %>

                    <div class="mensagemSucesso">
                        <%= sucesso %>
                    </div>

                    <% } %>

                        <section class="quiz-nutri-secao">

                            <div class="quiz-nutri-titulo-secao">

                                <div>
                                    <span>Gerenciamento</span>
                                    <h2>Quizzes cadastrados</h2>
                                </div>

                                <div class="quiz-nutri-contador">

                                    <strong>
                                        <%= quizzes ? quizzes.length : 0 %>
                                    </strong>

                                    <span>
                                        <%= quizzes && quizzes.length===1 ? "quiz" : "quizzes" %>
                                    </span>

                                </div>

                            </div>

                            <% if (!quizzes || quizzes.length===0) { %>

                                <section class="quiz-nutri-vazio">

                                    <div class="quiz-nutri-vazio-icone">

                                        <svg viewBox="0 0 24 24" width="48" height="48" fill="none"
                                            stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <path d="M9 11l3 3L22 4"></path>
                                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                                        </svg>

                                    </div>

                                    <h2>Nenhum quiz cadastrado</h2>

                                    <p>
                                        Crie uma atividade personalizada para avaliar os
                                        conhecimentos nutricionais de um paciente.
                                    </p>

                                    <a href="/nutricionista/quizzes/novo" class="quiz-nutri-botao">
                                        Criar primeiro quiz
                                    </a>

                                </section>

                                <% } else { %>

                                    <div class="quiz-nutri-grade">

                                        <% quizzes.forEach(quiz=> { %>

                                            <article class="quiz-nutri-card">

                                                <div class="quiz-nutri-card-topo">

                                                    <div class="quiz-nutri-card-icone">

                                                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none"
                                                            stroke="currentColor" stroke-width="1.8"
                                                            stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M9 11l3 3L22 4"></path>
                                                            <path
                                                                d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11">
                                                            </path>
                                                        </svg>

                                                    </div>

                                                    <span class="quiz-nutri-paciente">
                                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none"
                                                            stroke="currentColor" stroke-width="2"
                                                            stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                                                            <circle cx="12" cy="7" r="4"></circle>
                                                        </svg>

                                                        <%= quiz.nome_usuario %>
                                                    </span>

                                                </div>

                                                <div class="quiz-nutri-card-conteudo">

                                                    <h2>
                                                        <%= quiz.titulo %>
                                                    </h2>

                                                    <p>
                                                        <%= quiz.descricao || "Sem descrição cadastrada." %>
                                                    </p>

                                                </div>

                                                <div class="quiz-nutri-quantidade">

                                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                                        stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                        stroke-linejoin="round">
                                                        <path d="M8 6h13"></path>
                                                        <path d="M8 12h13"></path>
                                                        <path d="M8 18h13"></path>
                                                        <path d="M3 6h.01"></path>
                                                        <path d="M3 12h.01"></path>
                                                        <path d="M3 18h.01"></path>
                                                    </svg>

                                                    <strong>
                                                        <%= quiz.total_perguntas %>
                                                    </strong>

                                                    <span>
                                                        <%= Number(quiz.total_perguntas)===1 ? "pergunta cadastrada"
                                                            : "perguntas cadastradas" %>
                                                    </span>

                                                </div>

                                                <div class="quiz-nutri-acoes">

                                                    <a href="/nutricionista/quizzes/<%= quiz.id_quiz %>/perguntas"
                                                        class="quiz-nutri-botao">
                                                        Perguntas
                                                    </a>

                                                    <a href="/nutricionista/quizzes/<%= quiz.id_quiz %>/editar"
                                                        class="quiz-nutri-botao-secundario" aria-label="Editar quiz">
                                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                                            stroke="currentColor" stroke-width="2"
                                                            stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M12 20h9"></path>
                                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                                                        </svg>

                                                        Editar
                                                    </a>

                                                    <a href="/nutricionista/quizzes/<%= quiz.id_quiz %>/estatisticas"
                                                        class="quiz-nutri-botao-secundario"
                                                        aria-label="Ver estatísticas">
                                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                                            stroke="currentColor" stroke-width="2"
                                                            stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M3 3v18h18"></path>
                                                            <path d="m7 16 4-4 4 3 5-6"></path>
                                                        </svg>

                                                        Estatísticas
                                                    </a>

                                                    <form action="/nutricionista/quizzes/<%= quiz.id_quiz %>/excluir"
                                                        method="POST"
                                                        onsubmit="return confirm('Deseja realmente excluir este quiz e todas as suas perguntas?')">

                                                        <button type="submit" class="quiz-nutri-botao-excluir"
                                                            aria-label="Excluir quiz">
                                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                                                stroke="currentColor" stroke-width="2"
                                                                stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M3 6h18"></path>
                                                                <path d="M8 6V4h8v2"></path>
                                                                <path d="M19 6l-1 14H6L5 6"></path>
                                                                <path d="M10 11v5"></path>
                                                                <path d="M14 11v5"></path>
                                                            </svg>

                                                            Excluir
                                                        </button>

                                                    </form>

                                                </div>

                                            </article>

                                            <% }) %>

                                    </div>

                                    <% } %>

                        </section>

            </main>

</body>

</html>