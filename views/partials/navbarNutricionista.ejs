<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=logout,person" />
<header class="navbar">
    <div class="logo">
        <img src="/img/logo.png" alt="Logo NutriTech">
        <h2>NutriTech</h2>
    </div>

    <button type="button" class="botao-menu-mobile" aria-label="Abrir menu" aria-expanded="false">
        <span></span><span></span><span></span>
    </button>

    <nav class="menu">
        <a href="/nutricionista/home">Home</a>
        <a href="/nutricionista/pacientes">Pacientes</a>
        <a href="/nutricionista/cardapios">Cardápios</a>
        <a href="/nutricionista/quizzes">Quiz</a>
        <a href="/nutricionista/ajuda">Ajuda</a>
    </nav>

    <div class="usuarioNavbar">
        <button type="button" class="botao-perfil" aria-label="Abrir menu do perfil" aria-expanded="false" aria-haspopup="true">
            <span class="icone-perfil-desktop" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M5.5 20c.7-3.2 3.1-5.2 6.5-5.2s5.8 2 6.5 5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
            </span>
            <% if (usuario && usuario.foto) { %>
                <img src="/uploads/<%= usuario.foto %>" alt="Foto de perfil de <%= usuario.nome %>" class="fotoPerfil">
            <% } else { %>
                <img src="/img/icone_padrao.png" alt="Foto de perfil padrão" class="fotoPerfil">
            <% } %>
            <strong><%= usuario.nome %></strong>
        </button>

        <div class="menu-usuario">
            <a href="/nutricionista/perfil">
                <span class="material-symbols-outlined">person</span>
                Perfil
            </a>
            <a href="/logout">
                <span class="material-symbols-outlined">logout</span>
                Sair
            </a>
        </div>
    </div>
</header>
<script src="/js/navbar.js"></script>
